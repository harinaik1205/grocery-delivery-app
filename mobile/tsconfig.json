{
  "extends": "@react-native/typescript-config",
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"],
  "compilerOptions": {
    "typeRoots": ["node_modules/@types", "src/types"],
    "types": ["jest"],
    "baseUrl": "./src/",
    "paths": {
      // "*":["src/*"],
      "@assets/*": ["assets/*"],
      "@features/*": ["features/*"],
      "@services/*": ["services/*"],
      "@styles/*": ["styles/*"],
      "@navigation/*": ["navigation/*"],
      "@components/*": ["components/*"],
      "@state/*": ["state/*"],
      "@utils/*": ["utils/*"]
    }
  }
}
